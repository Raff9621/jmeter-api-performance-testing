        {
          "name": "login_campi_vuoti_(NEGATIVO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Il test negativo blocca l'accesso (Stato 400 o 422 o 400)\", function () {\r\n    // Ci aspettiamo un codice di errore (es. 400 o 422) perché i dati non sono validi\r\n    pm.expect(pm.response.code).to.be.oneOf([400, 422, 401]);\r\n});\r\n\r\npm.test(\"La risposta contiene un messaggio di errore\", function () {\r\n    var jsonData = pm.response.json();\r\n    // Verifichiamo che il server restituisca una spiegazione dell'errore\r\n    pm.expect(jsonData).to.have.property('message');\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
